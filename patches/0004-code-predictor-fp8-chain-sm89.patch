+            gu = torch.stack((gu[:inter].reshape(-1, half, hid), gu[inter:].reshape(-1, half, hid)), 1)
+            self.w8.append(
+                dict(
+                    qkv=_w8_quant(fold(L["qkv"], L["ln1"])),
+                    o=_w8_quant(L["o"].t()),
+                    gu=_w8_quant(gu.reshape(-1, hid)),
+                    down=_w8_quant(L["down"].t()),
