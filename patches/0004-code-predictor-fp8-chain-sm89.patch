+    def _init_w8(self, max_batch: int) -> None:
+        dev, hid = self.norm_w.device, self.hidden
+
+        def fold(wt: torch.Tensor, ln: torch.Tensor) -> torch.Tensor:
+            return wt.float().t() * ln.float()[None, :]
